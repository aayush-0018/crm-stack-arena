PORT=4000
HOST=127.0.0.1
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# --- Local Postgres (default) ---
DATABASE_URL=postgres://crm:crm@localhost:5432/crm_dev

# --- Hosted Postgres (Supabase) ---
# Use the SESSION MODE pooler string from Supabase: Connect -> Direct -> Session pooler
# DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ALLOW_REMOTE_DB=true
# DATABASE_SSL=true

# --- Email (forgot password). See MAIL_SETUP.md ---
# Frontend address used in reset links (4173 if you run `npm run preview`)
APP_URL=http://localhost:5173
# console = print emails to this terminal (default, nothing is sent)
MAIL_PROVIDER=console
# For production on Render (SMTP is blocked there, so these are HTTP APIs):
# MAIL_PROVIDER=brevo
# MAIL_API_KEY=xkeysib-...
# MAIL_FROM=the-sender-you-verified-in-brevo@example.com
# MAIL_FROM_NAME=Your Shop Name
